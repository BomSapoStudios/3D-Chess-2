# ─────────────────────────────────────────────────────
# 3D Chess Server v2 — Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────

# Server
PORT=3001
NODE_ENV=development

# ─── Database ─────────────────────────────────────────
# Development (SQLite — zero setup, works out of the box):
DATABASE_URL="file:./dev.db"

# Production (PostgreSQL — get a free one from supabase.com):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# ─── Redis ────────────────────────────────────────────
# Development: leave blank — falls back to in-memory Map
REDIS_URL=""

# Production (get a free one from upstash.com):
# REDIS_URL="rediss://default:PASSWORD@HOST:PORT"

# ─── JWT ──────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="CHANGE_ME_generate_a_long_random_secret"
JWT_REFRESH_SECRET="CHANGE_ME_generate_a_different_long_random_secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# ─── CORS ─────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# ─── Game Settings ────────────────────────────────────
DISCONNECT_GRACE_PERIOD_MS=120000
AI_AUTOFILL_DELAY_MS=30000
MAX_ROOMS=500
MAX_PLAYERS_PER_ROOM=6

# ─── Logging ──────────────────────────────────────────
LOG_LEVEL=debug
